{
  "name": "urlovingly-invites-edge",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test test/",
    "db:create": "wrangler d1 create urlovingly-invites",
    "db:migrate:local": "wrangler d1 migrations apply urlovingly-invites --local",
    "db:migrate:remote": "wrangler d1 migrations apply urlovingly-invites --remote",
    "db:seed:local": "wrangler d1 execute urlovingly-invites --local --file=seed.sql",
    "db:seed:remote": "wrangler d1 execute urlovingly-invites --remote --file=seed.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
